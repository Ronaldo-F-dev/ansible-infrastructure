# Managed by Ansible.
# Manual changes will be overwritten.

server {
    listen {{ item.listen_port }};
    listen [::]:{{ item.listen_port }};

    server_name {{ item.server_name }};

    root {{ item.root }};
    index {{ item.index | default('index.html') }};

    location / {
        try_files $uri $uri/ =404;
    }
}