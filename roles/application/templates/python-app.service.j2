[Unit]
Description={{ item.name }} application service
After=network.target

[Service]
Type=simple

User={{ item.user }}
Group={{ item.group }}

WorkingDirectory={{ item.deploy_path }}/{{ application_current_link_name }}

ExecStart={{ item.deploy_path }}/{{ application_current_link_name }}/.venv/bin/gunicorn \
  --workers {{ item.runtime.workers | default(2) }} \
  --bind {{ item.runtime.bind }} \
  --no-control-socket \
  {{ item.runtime.module }}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target