#!/usr/bin/env bash

set -Eeuo pipefail

BACKUP_DIR="{{ backup_base_dir }}/mysql"
RETENTION_DAYS="{{ backup_retention_days }}"
MYSQL_SOCKET="/var/run/mysqld/mysqld.sock"
TIMESTAMP="$(date -u '+%Y%m%dT%H%M%SZ')"

{% for database in backup_mysql_databases %}
DATABASE="{{ database }}"
FINAL_FILE="${BACKUP_DIR}/${DATABASE}_${TIMESTAMP}.sql"
TEMP_FILE="${FINAL_FILE}.tmp"

echo "Backing up MySQL database: ${DATABASE}"

rm -f "${TEMP_FILE}"

if mysqldump \
    --protocol=socket \
    --socket="${MYSQL_SOCKET}" \
    --single-transaction \
    --routines \
    --triggers \
    --events \
    "${DATABASE}" > "${TEMP_FILE}"; then

    if [ ! -s "${TEMP_FILE}" ]; then
        echo "Backup validation failed: ${DATABASE}" >&2
        rm -f "${TEMP_FILE}"
        exit 1
    fi

    mv "${TEMP_FILE}" "${FINAL_FILE}"
    chmod 0600 "${FINAL_FILE}"

    echo "Backup completed: ${FINAL_FILE}"
else
    rm -f "${TEMP_FILE}"
    echo "Backup failed: ${DATABASE}" >&2
    exit 1
fi

{% endfor %}

find "${BACKUP_DIR}" \
    -type f \
    -name '*.sql' \
    -mtime "+${RETENTION_DAYS}" \
    -delete